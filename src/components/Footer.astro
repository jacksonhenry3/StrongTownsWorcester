---
const currentYear = new Date().getFullYear();
---
<footer class="bg-gray-900 text-gray-400 p-8 text-center mt-auto">
	<div class="container mx-auto">
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
			<div class="text-left">
				<img src="/stwLogo.jpg" alt="Strong Towns Worcester logo" class="w-12 h-12 rounded-md mb-2" />
				<p class="text-white font-semibold">Strong Towns Worcester</p>
				<p class="text-sm text-gray-400">Building a more resilient, fiscally-sound Worcester.</p>
			</div>

			<div class="text-left">
				<h4 class="font-semibold text-white mb-2">Resources</h4>
				<ul class="text-sm space-y-1">
					<li><a href="/about" class="hover:underline">About</a></li>
					<li><a href="https://www.strongtowns.org/" target="_blank" rel="noopener noreferrer" class="hover:underline">Strong Towns</a></li>
					<li><a href="#join" class="hover:underline">Get Involved</a></li>
				</ul>
			</div>

			<div class="text-left">
				<h4 class="font-semibold text-white mb-2">Connect</h4>
				<div class="flex items-center gap-3 justify-start">
					<a href="https://www.facebook.com/groups/1451080135600490/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-gray-400 hover:text-white">
						<svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 10-11.5 9.87v-6.99H8.9v-2.88h1.6V9.41c0-1.58.94-2.46 2.38-2.46.69 0 1.41.12 1.41.12v1.55h-.8c-.79 0-1.03.49-1.03.99v1.19h1.75l-.28 2.88h-1.47V22A10 10 0 0022 12z"/></svg>
					</a>
					<a href="https://www.instagram.com/strongtownsworcesterma/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-gray-400 hover:text-white">
						<svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 7h10v10H7z"/></svg>
					</a>
					<a href="https://discord.gg/JszTyuxxaZ" target="_blank" rel="noopener noreferrer" aria-label="Discord" class="text-gray-400 hover:text-white">
						<svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.369A19.791 19.791 0 0016.17 3c-.18.31-.38.72-.52 1.04-1.52-.24-3.04-.24-4.56 0-.14-.33-.36-.74-.54-1.05a19.736 19.736 0 00-4.16 1.37c-1.96 3.3-2.35 6.49-1.73 9.61 2.81 2.09 5.53 2.02 8.15 1.25 2.06-.63 3.7-1.71 4.88-3.14 0-.01.01-.02.01-.02 1.26-3.66.39-7.21-1.23-9.45zM8.02 13.5c-.83 0-1.5-.74-1.5-1.65 0-.9.67-1.64 1.5-1.64s1.5.74 1.5 1.64c0 .91-.67 1.65-1.5 1.65zm7.96 0c-.83 0-1.5-.74-1.5-1.65 0-.9.67-1.64 1.5-1.64s1.5.74 1.5 1.64c0 .91-.67 1.65-1.5 1.65z"/></svg>
					</a>
				</div>
				<p class="text-sm text-gray-500 mt-3">&copy; {currentYear} Strong Towns Worcester, MA</p>
			</div>
		</div>
	</div>
</footer>
