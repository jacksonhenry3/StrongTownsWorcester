var IDX=[];
opp.eachLayer(function(l){var p=l.feature.properties;IDX.push({k:'o',a:p.a,t:norm(p.a),p:p,l:l,pane:'pOpp'})});
[existB,existU].forEach(function(g){g.eachLayer(function(l){var p=l.feature.properties;IDX.push({k:'e',a:p.a,t:norm(p.a),p:p,l:l,pane:p.b==='u'?'pExistU':'pExistB'})})});
unch.eachLayer(function(l){var p=l.feature.properties;IDX.push({k:'n',a:p.a,t:norm(p.a),p:p,l:l,pane:'pUnch'})});errL.eachLayer(function(l){var p=l.feature.properties;IDX.push({k:'c',a:p.a,t:norm(p.a),p:p,l:l,pane:'pErr'})});
var q=document.getElementById('q'),res=document.getElementById('sres'),ans=document.getElementById('answer');
function find(v){var qt=norm(v);if(!qt.length)return[];var out=IDX.filter(function(e){return qt.every(function(w,i){var ex=/^\d+$/.test(w)&&i<qt.length-1;return e.t.some(function(x){return ex?x===w:x.indexOf(w)===0})})});
  out.sort(function(a,b){return a.a.localeCompare(b.a,undefined,{numeric:true})});return out}
function show(list){res.innerHTML='';ans.hidden=true;var cur=list.slice(0,6);
  cur.forEach(function(e){var li=document.createElement('li');li.textContent=e.a+' ('+e.p.z+')';li.onmousedown=function(ev){ev.preventDefault();pick(e)};li.ontouchend=function(ev){ev.preventDefault();pick(e)};res.appendChild(li)});
  res.hidden=!cur.length;
  if(!cur.length&&q.value.trim()){res.hidden=true;ans.hidden=false;ans.className='none';ans.textContent="We didn't find that address among the lots that could split or the lots below their district's minimum. It may meet the minimum already, be in another district, or be a different kind of property."}}
function pick(e){res.hidden=true;q.value=e.a;q.blur();ans.hidden=false;var p=e.p;
  if(e.k==='c'){ans.className='none';ans.textContent=p.a+": the source data for this lot has a potential data issue, so we haven't counted it."}
  else if(e.k==='n'){ans.className='none';ans.innerHTML='<b>'+p.a+'</b> is '+n(p.s)+' sq ft. Today\'s rules already allow the same number of lots as a 5,000 sq ft minimum ('+p.p+'), so this change would not affect it.'}
  else if(e.k==='o'){ans.className='';ans.innerHTML='<b>'+p.a+'</b> is '+n(p.s)+' sq ft in '+p.z+'. By area and frontage it could hold up to <b>'+p.p+' lots</b> under a 5,000 sq ft minimum (today: '+p.q+'). Potential only: we did not check where the house sits, wetlands or other limits.'}
  else if(p.b==='u'){ans.className='red';ans.innerHTML='<b>'+p.a+'</b> is '+n(p.s)+' sq ft, under 5,000. A 5,000 sq ft minimum would not apply to this lot.'}
  else{ans.className='warm';ans.innerHTML='<b>'+p.a+'</b> is '+n(p.s)+' sq ft. The minimum in '+p.z+' is '+n(p.m)+', so your lot is '+n(p.m-p.s)+' sq ft below it. A 5,000 sq ft minimum would meet the lot-size rule.'}
  if(e.pane==='pUnch'||e.pane==='pErr'){setPane(e.pane,true);document.getElementById('extra').open=true}
  if(e.l){if(mq.matches&&!document.body.classList.contains('explore'))setExplore(true);var b=e.l.getBounds();map.flyToBounds(b,{maxZoom:18,padding:[60,60],animate:!reduce,duration:1.2});setTimeout(function(){e.l.openPopup(b.getCenter())},1300)}}
var mq2=document.getElementById('mq'),mres=document.getElementById('mres'),mmsg=document.getElementById('mmsg');
function mshow(list){mres.innerHTML='';mmsg.hidden=true;var cur=list.slice(0,7);
  cur.forEach(function(e){var li=document.createElement('li');li.textContent=e.a+' ('+e.p.z+')'+(e.k==='c'?' - potential data issue':(e.k==='n'?' - unchanged':''));li.onmousedown=function(ev){ev.preventDefault();mpick(e)};li.ontouchend=function(ev){ev.preventDefault();mpick(e)};mres.appendChild(li)});
  mres.hidden=!cur.length;
  if(!cur.length&&mq2.value.trim()){mmsg.hidden=false;mmsg.textContent="No match among the lots on this map. It may meet its district's minimum already, be in another district, or be another kind of property."}}
function mpick(e){mres.hidden=true;mmsg.hidden=true;mq2.value=e.a;mq2.blur();if(mq.matches&&!document.body.classList.contains('explore'))setExplore(true);setPane(e.pane,true);if(e.pane==='pUnch'||e.pane==='pErr')document.getElementById('extra').open=true;var b=e.l.getBounds();map.flyToBounds(b,{maxZoom:18,padding:[80,80],animate:!reduce,duration:1.2});setTimeout(function(){e.l.openPopup(b.getCenter())},1300)}
mq2.addEventListener('input',function(){mshow(find(mq2.value))});
mq2.addEventListener('keydown',function(ev){if(ev.key==='Enter'){ev.preventDefault();var l=find(mq2.value);if(l.length)mpick(l[0])}});
q.addEventListener('input',function(){show(find(q.value))});
q.addEventListener('keydown',function(ev){if(ev.key==='Enter'){ev.preventDefault();var l=find(q.value);if(l.length)pick(l[0])}});
q.addEventListener('focus',function(){if(!manual)go('burncoat')});
if(DOTS){dotsReady=true;syncDots()}
})();
</script>
</Layout>
