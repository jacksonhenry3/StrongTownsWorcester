---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Strong Towns Worcester, MA | Building a More Resilient City">
    <section class="bg-gray-50 py-16 md:py-24">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto text-center">
                <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-6">
                    <span class="emoji">🚧</span> Under Construction
                </h1>
                <p class="text-lg md:text-xl text-gray-700 leading-relaxed max-w-2xl mx-auto">
                    This page is currently under construction. Please check back later.
                </p>
                <p class="text-lg md:text-xl text-gray-700 leading-relaxed max-w-2xl mx-auto mt-4">
                    In the meantime, join our <a href="https://discord.gg/JszTyuxxaZ" target="_blank" rel="noopener noreferrer" class="text-stw-primary underline font-medium">Discord</a> to stay up to date.
                </p>
            </div>
        </div>
    </section>
</Layout>
