---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
---

<Layout title="Strong Towns Worcester, MA | Building a More Resilient City">
		<section class="bg-white py-16 md:py-24">
			<div class="container mx-auto px-4">
				<div class="max-w-4xl mx-auto text-center">
					<div class="inline-flex items-center gap-3 mb-6 px-4 py-1 rounded-full bg-stw-secondary/10 text-stw-primary font-medium">
						<svg class="w-5 h-5 text-stw-primary" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2L15 8H9L12 2Z" fill="currentColor"/></svg>
						Local group of Strong Towns
					</div>

					<h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-6">Building a Financially Strong & Resilient Worcester</h1>

					<p class="text-lg md:text-xl text-gray-700 leading-relaxed max-w-2xl mx-auto">
						We are a community of advocates in Worcester, MA, part of the national
						<a href="https://www.strongtowns.org/" target="_blank" rel="noopener noreferrer" class="text-stw-primary underline font-medium">Strong Towns</a>
						movement. We promote incremental, fiscally responsible growth and community-led solutions to make Worcester more livable and resilient.
					</p>

					<div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
						<a href="#join" class="inline-flex items-center gap-3 bg-stw-primary text-white font-semibold py-3 px-5 rounded-lg shadow-md hover:opacity-95 focus:outline-none focus:ring-4 focus:ring-stw-primary/30">
							<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
							Join the Conversation
						</a>

						<a href="/about" class="inline-flex items-center gap-2 border border-gray-200 text-gray-800 bg-white px-4 py-3 rounded-lg shadow-sm hover:shadow-md">Learn More</a>
					</div>
				</div>

				<div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
					<div class="p-6 bg-white rounded-xl shadow-sm">
						<h3 class="font-bold text-stw-primary mb-2">Community-led</h3>
						<p class="text-gray-600 text-sm">Local neighbors driving practical solutions and conversations about growth.</p>
					</div>
					<div class="p-6 bg-white rounded-xl shadow-sm">
						<h3 class="font-bold text-stw-primary mb-2">Fiscal Responsibility</h3>
						<p class="text-gray-600 text-sm">Advocating for development that supports long-term municipal finances.</p>
					</div>
					<div class="p-6 bg-white rounded-xl shadow-sm">
						<h3 class="font-bold text-stw-primary mb-2">Walkable, Healthy Streets</h3>
						<p class="text-gray-600 text-sm">Encouraging incremental improvements that make neighborhoods safer and more vibrant.</p>
					</div>
				</div>
			</div>
		</section>

	<section class="bg-stw-primary">
		<SocialLinks />
	</section>

</Layout>
