---
import Header from '../components/Header.astro';
import SocialLinks from '../components/SocialLinks.astro';
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
			<meta charset="UTF-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1" />
			<meta name="description" content="Strong Towns Worcester, MA — building a financially strong and resilient Worcester through community-driven, incremental development." />
			<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
			<meta name="generator" content={Astro.generator} />
			<title>{title}</title>

			<link rel="preconnect" href="https://fonts.googleapis.com">
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">

			<!-- Using local Tailwind/PostCSS build via importing src/styles/global.css -->
			<link rel="stylesheet" href="/styles/global.css">
		</head>

	<body class="bg-gray-50 text-gray-800 font-sans flex flex-col min-h-screen">
		<Header />
		<main class="flex-grow">
			<slot />
		</main>
		<footer class="bg-stw-primary">
			<SocialLinks />
		</footer>
	</body>
</html>